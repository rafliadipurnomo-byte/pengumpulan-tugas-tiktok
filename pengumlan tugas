<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal Pengumpulan Tugas TikTok — UNIMUS</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Tone.js untuk Suara Lonceng Notifikasi Chrome -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        unimus: {
                            navy: '#0B2447',
                            blue: '#19376D',
                            accent: '#2563EB',
                            gold: '#D97706',
                        },
                        tiktok: {
                            pink: '#FE2C55',
                            cyan: '#25F4EE',
                            dark: '#0F172A'
                        }
                    },
                    boxShadow: {
                        'soft': '0 10px 40px -10px rgba(11, 36, 71, 0.08)',
                        'card': '0 4px 24px -2px rgba(15, 23, 42, 0.06)',
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background: radial-gradient(circle at top right, #EEF4FF 0%, #F8FAFC 45%, #F1F5F9 100%);
        }
        .glass-header {
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
        }
        .hero-gradient {
            background: linear-gradient(135deg, #0B2447 0%, #19376D 55%, #1E40AF 100%);
        }
        /* Scrollbar halus */
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #CBD5E1; border-radius: 9999px; }
        ::-webkit-scrollbar-thumb:hover { background: #94A3B8; }
    </style>
</head>
<body class="text-slate-800 min-h-screen flex flex-col antialiased selection:bg-unimus-blue selection:text-white">

    <!-- =====================================================================
         1. TOP BAR RESMI UNIMUS (Terlihat oleh Mahasiswa, Terkunci untuk Admin)
         ===================================================================== -->
    <div id="unimus-official-topbar" class="w-full bg-white border-b border-slate-200/80 shadow-xs relative z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex items-center justify-between gap-4">
            <!-- Sisi Kiri: Logo UNIMUS & Banner Pemeringkatan -->
            <div class="flex items-center gap-3 sm:gap-5 overflow-x-auto no-scrollbar py-0.5 flex-1">
                <!-- Logo UNIMUS 2026 -->
                <div class="flex items-center shrink-0">
                    <img id="img-unimus-logo" src="LOgo Unimus baru 2026.png" alt="Logo UNIMUS"
                        class="h-10 sm:h-12 w-auto object-contain select-none transition-transform duration-200 hover:scale-105">
                    <button type="button" id="btn-quick-upload-logo"
                        class="admin-only hidden items-center gap-1.5 px-3 py-1.5 rounded-xl bg-blue-50 hover:bg-blue-100 text-unimus-navy border border-blue-200 text-xs font-semibold transition-all">
                        <i data-lucide="image-plus" class="w-3.5 h-3.5 text-unimus-accent"></i>
                        <span>Pasang Logo UNIMUS</span>
                    </button>
                </div>

                <div class="h-8 w-px bg-slate-200 shrink-0 hidden sm:block"></div>

                <!-- Banner Pemeringkatan Resmi UNIMUS -->
                <div class="flex items-center shrink-0">
                    <img id="img-unimus-banner" src="Logo Sosmed baru banget (2)_2.jpg" alt="Banner Resmi UNIMUS"
                        class="h-9 sm:h-12 w-auto max-w-none object-contain select-none">
                    <button type="button" id="btn-quick-upload-banner"
                        class="admin-only hidden items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-900 border border-amber-200 text-xs font-semibold transition-all">
                        <i data-lucide="upload-cloud" class="w-3.5 h-3.5 text-amber-600"></i>
                        <span>Pasang Banner Pemeringkatan</span>
                    </button>
                </div>
            </div>

            <!-- Sisi Kanan: Kontrol Admin (Hanya Muncul Saat Mode Admin Aktif) -->
            <div class="admin-only hidden items-center gap-2 shrink-0">
                <button type="button" id="btn-open-branding-modal"
                    class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-colors">
                    <i data-lucide="palette" class="w-3.5 h-3.5 text-unimus-blue"></i>
                    <span class="hidden md:inline">Ubah Logo/Banner</span>
                </button>
            </div>
        </div>
    </div>

    <!-- =====================================================================
         2. NAVBAR PORTAL UTAMA
         ===================================================================== -->
    <header class="glass-header border-b border-slate-200/70 sticky top-0 z-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-3">
            <!-- Identitas Portal -->
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-2xl hero-gradient flex items-center justify-center shadow-md shadow-blue-950/15 shrink-0 relative">
                    <i data-lucide="clapperboard" class="w-5 h-5 text-white"></i>
                    <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full bg-tiktok-pink border-2 border-white"></span>
                </div>
                <div>
                    <div class="flex items-center gap-2">
                        <h1 class="font-display font-bold text-base sm:text-lg text-unimus-navy tracking-tight">
                            Portal Tugas TikTok
                        </h1>
                        <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider bg-blue-50 text-unimus-blue border border-blue-200/80">
                            UNIMUS
                        </span>
                    </div>
                    <p class="text-[11px] sm:text-xs text-slate-500">Universitas Muhammadiyah Semarang</p>
                </div>
            </div>

            <!-- Tombol Aksi Kanan -->
            <div class="flex items-center gap-2 sm:gap-2.5">
                <!-- Kontrol Khusus Admin/Dosen -->
                <div class="admin-only hidden items-center gap-2">
                    <button type="button" id="btn-notif-status"
                        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200/80 text-xs font-semibold transition-all">
                        <i data-lucide="bell-ring" class="w-3.5 h-3.5 text-amber-600"></i>
                        <span id="notif-status-label" class="hidden md:inline">Notifikasi Chrome</span>
                    </button>

                    <button type="button" id="btn-open-sheets-modal"
                        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200/80 text-xs font-semibold transition-all">
                        <i data-lucide="sheet" class="w-3.5 h-3.5 text-emerald-600"></i>
                        <span id="sheets-status-label" class="hidden md:inline">Google Sheets</span>
                    </button>

                    <button type="button" id="btn-lock-admin"
                        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 text-xs font-semibold transition-all"
                        title="Kunci Kembali ke Tampilan Mahasiswa">
                        <i data-lucide="lock" class="w-3.5 h-3.5"></i>
                        <span class="hidden sm:inline">Kunci</span>
                    </button>
                </div>

                <!-- Tombol Masuk Mode Admin (Untuk Dosen) -->
                <button type="button" id="btn-unlock-admin"
                    class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-slate-200/80 text-slate-700 text-xs font-semibold transition-all">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5 text-unimus-blue"></i>
                    <span>Dasbor Dosen</span>
                </button>
            </div>
        </div>
    </header>

    <!-- =====================================================================
         3. TOAST NOTIFIKASI HALUS
         ===================================================================== -->
    <div id="toast-container" class="fixed bottom-5 right-5 z-50 flex flex-col gap-2.5 max-w-sm w-full pointer-events-none px-4 sm:px-0"></div>

    <!-- =====================================================================
         4. KONTEN UTAMA
         ===================================================================== -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-7 sm:py-10">
        <div id="main-layout-grid" class="grid grid-cols-1 lg:grid-cols-12 gap-7 items-start">

            <!-- KOLOM KIRI / TENGAH: FORMULIR PENGUMPULAN TUGAS MAHASISWA -->
            <section id="student-form-column" class="lg:col-span-6 lg:col-start-4 transition-all duration-300">
                <div class="bg-white rounded-3xl shadow-soft border border-slate-200/80 overflow-hidden">
                    <!-- Header Kartu Hero UNIMUS -->
                    <div class="hero-gradient px-6 sm:px-8 py-7 text-white relative overflow-hidden">
                        <div class="absolute -right-8 -top-8 w-36 h-36 rounded-full bg-white/5 blur-xl"></div>
                        <div class="absolute right-6 bottom-0 w-24 h-24 rounded-full bg-tiktok-cyan/10 blur-lg"></div>

                        <div class="relative z-10">
                            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/15 backdrop-blur-xs text-[11px] font-semibold text-blue-100 mb-3">
                                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                Formulir Pengumpulan Online
                            </div>
                            <h2 class="font-display text-xl sm:text-2xl font-extrabold tracking-tight">
                                Kumpulkan Tugas Video TikTok
                            </h2>
                            <p class="text-xs sm:text-sm text-blue-100/90 mt-1.5 leading-relaxed">
                                Lengkapi identitas mahasiswa dan tempelkan tautan video TikTok Anda. Data otomatis tersimpan ke rekap dosen & Google Sheets.
                            </p>
                        </div>
                    </div>

                    <!-- Form Input -->
                    <form id="submission-form" class="p-6 sm:p-8 space-y-5" novalidate>
                        <!-- Nama Lengkap -->
                        <div class="space-y-1.5">
                            <label for="input-nama" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                                Nama Lengkap Mahasiswa <span class="text-rose-500">*</span>
                            </label>
                            <div class="relative group">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 group-focus-within:text-unimus-blue transition-colors">
                                    <i data-lucide="user" class="w-4 h-4"></i>
                                </span>
                                <input type="text" id="input-nama" required placeholder="Contoh: Aisyah Putri Maharani"
                                    class="w-full pl-10 pr-4 py-3 rounded-2xl bg-slate-50/70 border border-slate-200 text-sm text-slate-800 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-unimus-blue/25 focus:border-unimus-blue transition-all">
                            </div>
                            <p id="err-nama" class="hidden text-xs text-rose-600 font-medium flex items-center gap-1">
                                <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> Nama lengkap wajib diisi.
                            </p>
                        </div>

                        <!-- Baris NIM & Kelas -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div class="space-y-1.5">
                                <label for="input-nim" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                                    NIM <span class="text-rose-500">*</span>
                                </label>
                                <div class="relative group">
                                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 group-focus-within:text-unimus-blue transition-colors">
                                        <i data-lucide="id-card" class="w-4 h-4"></i>
                                    </span>
                                    <input type="text" id="input-nim" required placeholder="Contoh: C2C024001"
                                        class="w-full pl-10 pr-4 py-3 rounded-2xl bg-slate-50/70 border border-slate-200 text-sm text-slate-800 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-unimus-blue/25 focus:border-unimus-blue transition-all uppercase">
                                </div>
                                <p id="err-nim" class="hidden text-xs text-rose-600 font-medium flex items-center gap-1">
                                    <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> NIM wajib diisi.
                                </p>
                            </div>

                            <div class="space-y-1.5">
                                <label for="input-kelas" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                                    Kelas / Program Studi
                                </label>
                                <div class="relative group">
                                    <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 group-focus-within:text-unimus-blue transition-colors">
                                        <i data-lucide="graduation-cap" class="w-4 h-4"></i>
                                    </span>
                                    <input type="text" id="input-kelas" placeholder="Contoh: Informatika A"
                                        class="w-full pl-10 pr-4 py-3 rounded-2xl bg-slate-50/70 border border-slate-200 text-sm text-slate-800 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-unimus-blue/25 focus:border-unimus-blue transition-all">
                                </div>
                            </div>
                        </div>

                        <!-- Link Video TikTok -->
                        <div class="space-y-1.5">
                            <div class="flex items-center justify-between">
                                <label for="input-link" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                                    Tautan Video TikTok <span class="text-rose-500">*</span>
                                </label>
                                <button type="button" id="btn-paste-link"
                                    class="text-[11px] font-semibold text-unimus-blue hover:text-unimus-navy inline-flex items-center gap-1 transition-colors">
                                    <i data-lucide="clipboard-paste" class="w-3 h-3"></i>
                                    Tempel Link
                                </button>
                            </div>
                            <div class="relative group">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 group-focus-within:text-tiktok-pink transition-colors">
                                    <i data-lucide="link-2" class="w-4 h-4"></i>
                                </span>
                                <input type="url" id="input-link" required placeholder="https://www.tiktok.com/@username/video/..."
                                    class="w-full pl-10 pr-4 py-3 rounded-2xl bg-slate-50/70 border border-slate-200 text-sm text-slate-800 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-tiktok-pink/25 focus:border-tiktok-pink transition-all">
                            </div>
                            <p id="err-link" class="hidden text-xs text-rose-600 font-medium flex items-center gap-1">
                                <i data-lucide="alert-circle" class="w-3.5 h-3.5"></i> Masukkan tautan video TikTok yang valid.
                            </p>
                        </div>

                        <!-- Kartu Mini Pratinjau Otomatis Saat Mahasiswa Menempel Link -->
                        <div id="live-link-check-card" class="hidden rounded-2xl bg-slate-50 border border-slate-200/90 p-3.5 flex items-center justify-between gap-3">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="w-10 h-10 rounded-xl bg-tiktok-dark text-white flex items-center justify-center shrink-0">
                                    <i data-lucide="video" class="w-5 h-5 text-tiktok-cyan"></i>
                                </div>
                                <div class="min-w-0">
                                    <p id="live-link-title" class="text-xs font-bold text-slate-800 truncate">Tautan TikTok Terdeteksi</p>
                                    <p id="live-link-author" class="text-[11px] text-slate-500 truncate">Siap untuk dikirimkan</p>
                                </div>
                            </div>
                            <span class="px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700 text-[10px] font-bold shrink-0">
                                Valid
                            </span>
                        </div>

                        <!-- Catatan Opsional -->
                        <div class="space-y-1.5">
                            <label for="input-catatan" class="block text-xs font-bold uppercase tracking-wider text-slate-600">
                                Judul Konten / Keterangan <span class="text-slate-400 font-normal normal-case">(Opsional)</span>
                            </label>
                            <input type="text" id="input-catatan" placeholder="Contoh: Tugas Kampanye Digital Minggu ke-4"
                                class="w-full px-4 py-3 rounded-2xl bg-slate-50/70 border border-slate-200 text-sm text-slate-800 placeholder:text-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-unimus-blue/25 focus:border-unimus-blue transition-all">
                        </div>

                        <!-- Tombol Submit Utama -->
                        <div class="pt-2">
                            <button type="submit" id="btn-submit-tugas"
                                class="w-full py-3.5 px-6 rounded-2xl hero-gradient hover:opacity-95 active:scale-[0.99] text-white font-display font-bold text-sm shadow-lg shadow-blue-950/20 flex items-center justify-center gap-2.5 transition-all">
                                <i data-lucide="send" class="w-4 h-4"></i>
                                <span>Kirim Tugas Sekarang</span>
                            </button>
                        </div>
                    </form>

                    <!-- Konfirmasi Sukses Setelah Mahasiswa Mengirim -->
                    <div id="student-success-banner" class="hidden mx-6 sm:mx-8 mb-8 p-5 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-950 space-y-3">
                        <div class="flex items-start gap-3">
                            <div class="w-9 h-9 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 mt-0.5">
                                <i data-lucide="check-circle-2" class="w-5 h-5"></i>
                            </div>
                            <div class="space-y-1">
                                <h3 class="font-display font-bold text-sm text-emerald-900">Tugas Berhasil Dikirim!</h3>
                                <p id="success-detail-text" class="text-xs text-emerald-800 leading-relaxed">
                                    Data pengumpulan Anda telah tercatat di sistem dan diteruskan ke dosen pengampu.
                                </p>
                            </div>
                        </div>
                        <div class="flex justify-end">
                            <button type="button" id="btn-submit-another"
                                class="px-3.5 py-1.5 rounded-xl bg-white hover:bg-emerald-100 text-emerald-800 border border-emerald-300 text-xs font-semibold transition-colors">
                                Kirim Tugas Lainnya
                            </button>
                        </div>
                    </div>
                </div>
            </section>

            <!-- KOLOM KANAN: DASBOR PEMANTAU DOSEN / ADMIN (Terkunci untuk Mahasiswa) -->
            <section id="admin-dashboard-column" class="admin-only hidden lg:col-span-7 space-y-5">
                <!-- Kartu Statistik Ringkas -->
                <div class="grid grid-cols-3 gap-3 sm:gap-4">
                    <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-card">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Total Masuk</span>
                            <div class="w-7 h-7 rounded-lg bg-blue-50 text-unimus-blue flex items-center justify-center">
                                <i data-lucide="users" class="w-3.5 h-3.5"></i>
                            </div>
                        </div>
                        <p id="stat-total" class="font-display text-2xl font-extrabold text-unimus-navy mt-1">0</p>
                    </div>

                    <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-card">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Google Sheets</span>
                            <div class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center">
                                <i data-lucide="check-check" class="w-3.5 h-3.5"></i>
                            </div>
                        </div>
                        <p id="stat-synced" class="font-display text-2xl font-extrabold text-emerald-600 mt-1">0</p>
                    </div>

                    <div class="bg-white rounded-2xl p-4 border border-slate-200/80 shadow-card">
                        <div class="flex items-center justify-between">
                            <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Hari Ini</span>
                            <div class="w-7 h-7 rounded-lg bg-rose-50 text-tiktok-pink flex items-center justify-center">
                                <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                            </div>
                        </div>
                        <p id="stat-today" class="font-display text-2xl font-extrabold text-slate-800 mt-1">0</p>
                    </div>
                </div>

                <!-- Panel Daftar Pengumpulan & Pratinjau Video -->
                <div class="bg-white rounded-3xl shadow-soft border border-slate-200/80 overflow-hidden">
                    <div class="px-6 py-5 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <h2 class="font-display font-bold text-base sm:text-lg text-unimus-navy flex items-center gap-2">
                                <span>Daftar Pengumpulan Mahasiswa</span>
                                <span id="badge-live-count" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-unimus-blue">0</span>
                            </h2>
                            <p class="text-xs text-slate-500 mt-0.5">Klik <strong>Tonton Video</strong> untuk memutar video TikTok langsung di layar ini.</p>
                        </div>

                        <div class="flex items-center gap-2">
                            <button type="button" id="btn-export-csv"
                                class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold transition-colors">
                                <i data-lucide="download" class="w-3.5 h-3.5"></i>
                                <span>Unduh Excel (CSV)</span>
                            </button>
                            <button type="button" id="btn-clear-all"
                                class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 text-xs font-semibold transition-colors"
                                title="Bersihkan Semua Data Lokal">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Bilah Pencarian & Filter Kelas -->
                    <div class="px-6 py-3.5 bg-slate-50/70 border-b border-slate-100 flex flex-col sm:flex-row gap-2.5">
                        <div class="relative flex-1">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-slate-400">
                                <i data-lucide="search" class="w-4 h-4"></i>
                            </span>
                            <input type="text" id="input-search" placeholder="Cari nama mahasiswa atau NIM..."
                                class="w-full pl-9 pr-3 py-2 rounded-xl bg-white border border-slate-200 text-xs text-slate-800 focus:outline-none focus:border-unimus-blue">
                        </div>
                        <select id="filter-kelas"
                            class="px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs text-slate-700 font-medium focus:outline-none focus:border-unimus-blue">
                            <option value="">Semua Kelas</option>
                        </select>
                    </div>

                    <!-- List Kiriman Mahasiswa -->
                    <div id="submissions-list" class="divide-y divide-slate-100 max-h-[640px] overflow-y-auto">
                        <!-- Diisi secara dinamis -->
                    </div>

