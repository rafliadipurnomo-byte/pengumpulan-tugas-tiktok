            async function pullFromGoogleSheets() {
                if (!sheetsWebhookUrl) return;
                try {
                    const sep = sheetsWebhookUrl.includes('?') ? '&' : '?';
                    const res = await fetch(`${sheetsWebhookUrl}${sep}t=${Date.now()}`);
                    if (!res.ok) return;
                    const payload = await res.json();
                    const sheetItems = Array.isArray(payload) ? payload : (Array.isArray(payload.items) ? payload.items : []);

                    if (payload && payload.branding) {
                        if (payload.branding.logoData) {
                            sharedLogoData = payload.branding.logoData;
                            await vaultSet(STORAGE_LOGO_DATA, sharedLogoData);
                        }
                        if (payload.branding.bannerData) {
                            sharedBannerData = payload.branding.bannerData;
                            await vaultSet(STORAGE_BANNER_DATA, sharedBannerData);
                        }
                        applyBrandingAssets();
                    }

                    if (sheetItems.length > 0) {
                        const mapById = new Map();
                        submissionsList.forEach(item => mapById.set(item.id, item));
                        sheetItems.forEach(item => {
                            if (item && item.id) {
                                mapById.set(item.id, { ...mapById.get(item.id), ...item, synced: true });
                            }
                        });
                        submissionsList = Array.from(mapById.values()).sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
