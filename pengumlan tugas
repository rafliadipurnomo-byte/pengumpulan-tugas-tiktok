            async function initCloudSync() {
                await pullFromGoogleSheets();
                if (!db || !auth) return;

                try {
                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(auth);
                    }
                } catch (err) {
                    console.warn('Autentikasi cloud gagal, menggunakan penyimpanan lokal:', err);
                    return;
                }

                onAuthStateChanged(auth, (user) => {
                    currentUser = user;
                    if (!user) return;

                    // 1. Dengarkan Pengaturan Paten (Logo, Banner, & URL Google Sheets)
                    const settingsRef = doc(db, 'artifacts', appId, 'public', 'data', 'portal_settings', 'global_config');
                    onSnapshot(settingsRef, async (snap) => {
                        if (snap.exists()) {
                            const cfg = snap.data();
                            if (typeof cfg.logoData === 'string' && cfg.logoData) {
                                sharedLogoData = cfg.logoData;
                                await vaultSet(STORAGE_LOGO_DATA, cfg.logoData);
                            }
                            if (typeof cfg.bannerData === 'string' && cfg.bannerData) {
                                sharedBannerData = cfg.bannerData;
                                await vaultSet(STORAGE_BANNER_DATA, cfg.bannerData);
                            }
                            if (typeof cfg.sheetsWebhookUrl === 'string' && cfg.sheetsWebhookUrl) {
                                sheetsWebhookUrl = cfg.sheetsWebhookUrl;
                                await vaultSet(STORAGE_SHEETS_URL, cfg.sheetsWebhookUrl);
                                updateSheetsStatusBadge();
                            }
                            applyBrandingAssets();
                        } else if (sharedLogoData || sharedBannerData || sheetsWebhookUrl) {
                            await saveGlobalSettingsToCloud();
                        }
                    }, (err) => console.warn('Snapshot pengaturan:', err));

                    // 2. Dengarkan Daftar Tugas Mahasiswa secara Permanen & Real-Time
                    const subsColRef = collection(db, 'artifacts', appId, 'public', 'data', 'tiktok_submissions');
                    onSnapshot(subsColRef, async (snapshot) => {
                        const mapById = new Map();
                        submissionsList.forEach(item => mapById.set(item.id, item));

                        snapshot.forEach(docSnap => {
                            const data = docSnap.data();
                            if (data && data.id) {
                                mapById.set(data.id, data);
                            }
                        });

                        const mergedItems = Array.from(mapById.values()).sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));

                        if (isInitialSnapshotLoaded && mergedItems.length > submissionsList.length) {
                            const newestItem = mergedItems[0];
                            if (newestItem && isAdminUnlocked) {
                                notifyNewSubmission(newestItem);
                            }
                        }

                        submissionsList = mergedItems;
                        await vaultSet(STORAGE_SUBMISSIONS, submissionsList);
                        isInitialSnapshotLoaded = true;
                        renderDashboard();
                    }, (err) => console.warn('Snapshot tugas:', err));
                });
