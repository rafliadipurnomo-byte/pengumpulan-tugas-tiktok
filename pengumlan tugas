            // -----------------------------------------------------------------
            function escapeHtml(str) {
                return String(str).replace(/[&<>"']/g, m => ({
                    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
                }[m]));
            }

            function renderDashboard() {
                const searchQ = document.getElementById('input-search').value.toLowerCase().trim();
                const classFilter = document.getElementById('filter-kelas').value;
                const todayKey = new Date().toISOString().slice(0, 10);

                document.getElementById('stat-total').textContent  = submissionsList.length;
                document.getElementById('stat-synced').textContent = submissionsList.filter(x => x.synced).length;
                document.getElementById('stat-today').textContent  = submissionsList.filter(x => x.dateKey === todayKey).length;
                document.getElementById('badge-live-count').textContent = submissionsList.length;

                const kelasSelect = document.getElementById('filter-kelas');
                const uniqueClasses = [...new Set(submissionsList.map(x => x.kelas).filter(k => k && k !== '-'))];
                const prevSelected = kelasSelect.value;
                kelasSelect.innerHTML = `<option value="">Semua Kelas</option>` +
                    uniqueClasses.map(k => `<option value="${escapeHtml(k)}">${escapeHtml(k)}</option>`).join('');
                if (uniqueClasses.includes(prevSelected)) kelasSelect.value = prevSelected;

                const filtered = submissionsList.filter(item => {
                    const matchText = item.nama.toLowerCase().includes(searchQ) || item.nim.toLowerCase().includes(searchQ);
                    const matchClass = !classFilter || item.kelas === classFilter;
                    return matchText && matchClass;
                });

                if (filtered.length === 0) {
                    submissionsEl.innerHTML = '';
                    emptyStateEl.classList.remove('hidden');
                    return;
                }

                emptyStateEl.classList.add('hidden');
                submissionsEl.innerHTML = filtered.map((item, idx) => `
                    <div class="p-5 hover:bg-slate-50/80 transition-colors flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div class="space-y-1.5 min-w-0">
                            <div class="flex flex-wrap items-center gap-2">
                                <span class="font-display font-bold text-sm text-unimus-navy">${escapeHtml(item.nama)}</span>
                                <span class="px-2 py-0.5 rounded-lg bg-slate-100 text-slate-700 text-[11px] font-bold">${escapeHtml(item.nim)}</span>
                                ${item.kelas && item.kelas !== '-' ? `<span class="px-2 py-0.5 rounded-lg bg-blue-50 text-unimus-blue text-[11px] font-semibold">${escapeHtml(item.kelas)}</span>` : ''}
                                ${idx === 0 ? `<span class="px-2 py-0.5 rounded-full bg-rose-50 text-tiktok-pink text-[10px] font-bold">Baru</span>` : ''}
                            </div>
                            <p class="text-xs text-slate-500 truncate">${escapeHtml(item.link)}</p>
                            <div class="flex items-center gap-3 text-[11px] text-slate-400">
                                <span class="inline-flex items-center gap-1"><i data-lucide="clock" class="w-3 h-3"></i> ${escapeHtml(item.waktu)}</span>
                                <span class="inline-flex items-center gap-1 ${item.synced ? 'text-emerald-600 font-semibold' : 'text-blue-600 font-medium'}">
                                    <i data-lucide="${item.synced ? 'check-circle' : 'cloud-check'}" class="w-3 h-3"></i>
                                    ${item.synced ? 'Google Sheets & Cloud' : 'Tersimpan Permanen'}
                                </span>
                            </div>
                        </div>

                        <div class="flex items-center gap-2 shrink-0">
                            <button type="button" onclick="openTikTokPreview('${item.id}')"
                                class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-tiktok-pink hover:bg-rose-600 text-white text-xs font-bold shadow-sm transition-all">
                                <i data-lucide="play" class="w-3.5 h-3.5 fill-white"></i>
                                <span>Tonton Video</span>
                            </button>
                            <a href="${escapeHtml(item.link)}" target="_blank" rel="noopener noreferrer"
                                class="p-2 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors" title="Buka di Tab Baru">
                                <i data-lucide="external-link" class="w-4 h-4"></i>
                            </a>
                            <button type="button" onclick="deleteSubmission('${item.id}')"
                                class="p-2 rounded-xl bg-rose-50 hover:bg-rose-100 text-rose-600 transition-colors" title="Hapus Data">
                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>
                `).join('');
                lucide.createIcons();
            }

            document.getElementById('input-search').addEventListener('input', renderDashboard);
            document.getElementById('filter-kelas').addEventListener('change', renderDashboard);

            window.deleteSubmission = async (id) => {
                submissionsList = submissionsList.filter(x => x.id !== id);
                await vaultSet(STORAGE_SUBMISSIONS, submissionsList);
                renderDashboard();

                if (sheetsWebhookUrl) {
                    try {
                        await fetch(sheetsWebhookUrl, {
                            method: 'POST',
                            mode: 'no-cors',
                            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                            body: JSON.stringify({ action: 'delete_item', id })
                        });
                    } catch (e) {}
                }

                if (db && currentUser) {
                    try {
                        await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'tiktok_submissions', id));
                    } catch (err) {}
                }
                showToast('Dihapus', 'Data pengumpulan telah dihapus permanen.', 'info');
            };

            document.getElementById('btn-clear-all').addEventListener('click', async () => {
                if (submissionsList.length === 0) return;
                const toDelete = [...submissionsList];
                submissionsList = [];
                await vaultSet(STORAGE_SUBMISSIONS, []);
                renderDashboard();

                if (db && currentUser) {
                    for (const item of toDelete) {
                        try {
                            await deleteDoc(doc(db, 'artifacts', appId, 'public', 'data', 'tiktok_submissions', item.id));
                        } catch (err) {}
                    }
                }
                showToast('Bersih', 'Semua daftar riwayat telah dikosongkan.', 'info');
            });

            document.getElementById('btn-export-csv').addEventListener('click', () => {
                if (submissionsList.length === 0) {
                    showToast('Data Kosong', 'Belum ada data mahasiswa untuk diunduh.', 'warning');
                    return;
                }
                const header = ['Waktu', 'Nama Mahasiswa', 'NIM', 'Kelas', 'Link TikTok', 'Catatan'];
                const rows = submissionsList.map(x => [x.waktu, x.nama, x.nim, x.kelas, x.link, x.catatan]
                    .map(v => `"${String(v).replace(/"/g, '""')}"`).join(','));
                const csvContent = '\uFEFF' + [header.join(','), ...rows].join('\n');
                const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `Rekap_Tugas_TikTok_UNIMUS_${new Date().toISOString().slice(0, 10)}.csv`;
                a.click();
                URL.revokeObjectURL(url);
            });

            // -----------------------------------------------------------------
            // 9. PEMUTAR PRATINJAU VIDEO TIKTOK
            // -----------------------------------------------------------------
            const modalVideo = document.getElementById('modal-video-preview');
            const videoEmbedBox = document.getElementById('video-embed-box');
            const videoLoader = document.getElementById('video-loader');
            const videoFallback = document.getElementById('video-fallback-box');

            function extractVideoId(url) {
                const m = String(url).match(/\/(?:video|v|photo)\/(\d+)/i);
                return m ? m[1] : null;
            }

            function mountTikTokPlayer(videoId) {
                videoLoader.classList.add('hidden');
                videoFallback.classList.add('hidden');
                videoEmbedBox.innerHTML = `
                    <iframe
                        src="https://www.tiktok.com/embed/v2/${videoId}?lang=id-ID"
                        class="w-full max-w-[330px] h-[560px] rounded-2xl border border-slate-800 bg-black shadow-2xl"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen>
                    </iframe>
                `;
            }

            window.openTikTokPreview = async (id) => {
                const item = submissionsList.find(x => x.id === id);
                if (!item) return;

                document.getElementById('preview-student-name').textContent = item.nama;
                document.getElementById('preview-student-meta').textContent = `NIM: ${item.nim} • Kelas: ${item.kelas}`;
                document.getElementById('preview-student-note').textContent = item.catatan !== '-' ? item.catatan : item.link;
                document.getElementById('preview-external-link').href = item.link;

                videoEmbedBox.innerHTML = '';
                videoFallback.classList.add('hidden');
                videoLoader.classList.remove('hidden');

                openModal('modal-video-preview');

                const directId = extractVideoId(item.link);
                if (directId) {
                    mountTikTokPlayer(directId);
                    return;
                }

                try {
                    const res = await fetch(`https://www.tiktok.com/oembed?url=${encodeURIComponent(item.link)}`);
                    if (res.ok) {
                        const data = await res.json();
                        const resolvedId = data.embed_product_id || extractVideoId(data.html);
                        if (resolvedId) {
                            mountTikTokPlayer(resolvedId);
                            return;
                        }
                    }
                } catch (e) {}

                videoLoader.classList.add('hidden');
                videoFallback.classList.remove('hidden');
            };

            function closeVideoModal() {
                closeModal('modal-video-preview');
                videoEmbedBox.innerHTML = '';
            }

            document.getElementById('btn-close-video-preview').addEventListener('click', closeVideoModal);
            modalVideo.addEventListener('click', (e) => {
                if (e.target === modalVideo) closeVideoModal();
            });

            // -----------------------------------------------------------------
            // 10. HELPER MODAL UMUM & INISIALISASI
            // -----------------------------------------------------------------
            function openModal(id) {
                const m = document.getElementById(id);
                m.classList.remove('hidden');
                m.classList.add('flex');
                lucide.createIcons();
            }

            function closeModal(id) {
                const m = document.getElementById(id);
                m.classList.add('hidden');
                m.classList.remove('flex');
            }

            document.querySelectorAll('.close-modal').forEach(btn => {
                btn.addEventListener('click', () => closeModal(btn.dataset.target));
            });

            applyRoleView();
            await initCloudSync();
        });
    </script>
</body>
</html>
