    <!-- =====================================================================
         JAVASCRIPT APLIKASI (DENGAN PENYIMPANAN CLOUD & GOOGLE SHEETS DATABASE)
         ===================================================================== -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, deleteDoc, onSnapshot, collection } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // =====================================================================
        // PENYIMPANAN TAHAN REFRESH (INDEXEDDB + CLOUD FIRESTORE)
        // =====================================================================
        const STORAGE_SUBMISSIONS = 'unimus_tiktok_submissions_v1';
        const STORAGE_SHEETS_URL  = 'unimus_tiktok_sheets_url_v1';
        const STORAGE_LOGO_DATA   = 'unimus_tiktok_logo_v1';
        const STORAGE_BANNER_DATA = 'unimus_tiktok_banner_v1';
        const ADMIN_PIN_CODE      = 'unimus2026';

        const IDB_NAME = 'UNIMUS_TikTok_Portal_DB';
        const IDB_STORE = 'kv_store';

        function openLocalVault() {
            return new Promise((resolve) => {
                try {
                    const req = indexedDB.open(IDB_NAME, 1);
                    req.onupgradeneeded = (e) => {
                        const db = e.target.result;
                        if (!db.objectStoreNames.contains(IDB_STORE)) {
                            db.createObjectStore(IDB_STORE);
                        }
                    };
                    req.onsuccess = (e) => resolve(e.target.result);
                    req.onerror = () => resolve(null);
                } catch (e) {
                    resolve(null);
                }
            });
        }

        async function vaultGet(key) {
            const idb = await openLocalVault();
            if (!idb) return null;
            return new Promise((resolve) => {
                try {
                    const tx = idb.transaction(IDB_STORE, 'readonly');
                    const req = tx.objectStore(IDB_STORE).get(key);
                    req.onsuccess = () => resolve(req.result ?? null);
                    req.onerror = () => resolve(null);
                } catch (e) {
                    resolve(null);
                }
            });
        }

        async function vaultSet(key, value) {
            const idb = await openLocalVault();
            if (!idb) return;
            return new Promise((resolve) => {
                try {
                    const tx = idb.transaction(IDB_STORE, 'readwrite');
                    tx.objectStore(IDB_STORE).put(value, key);
                    tx.oncomplete = () => resolve(true);
                    tx.onerror = () => resolve(false);
                } catch (e) {
                    resolve(false);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', async () => {
            // Muat terlebih dahulu dari Config Tertanam (Google Sites) & IndexedDB
            let embeddedCfg = {};
            try {
                const cfgEl = document.getElementById('embedded-portal-config');
                if (cfgEl && cfgEl.textContent) embeddedCfg = JSON.parse(cfgEl.textContent);
            } catch (e) {}

            const [savedSubs, savedSheetsUrl, savedLogo, savedBanner] = await Promise.all([
                vaultGet(STORAGE_SUBMISSIONS),
                vaultGet(STORAGE_SHEETS_URL),
                vaultGet(STORAGE_LOGO_DATA),
                vaultGet(STORAGE_BANNER_DATA)
            ]);

            // Inisialisasi Cloud Database (Firestore)
            const appId = typeof __app_id !== 'undefined' ? __app_id : 'unimus-tiktok-portal';
            let db = null;
            let auth = null;
            let currentUser = null;

            try {
                if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                    const firebaseConfig = JSON.parse(__firebase_config);
                    const app = initializeApp(firebaseConfig);
                    db = getFirestore(app);
                    auth = getAuth(app);
                }
            } catch (e) {
                console.warn('Mode Google Sheets / Lokal aktif:', e);
            }

            // State Aplikasi (Prioritaskan Config Tertanam Google Sites -> IndexedDB)
            let submissionsList = Array.isArray(savedSubs) ? savedSubs : [];
            let sheetsWebhookUrl = (typeof savedSheetsUrl === 'string' && savedSheetsUrl)
                ? savedSheetsUrl
                : (embeddedCfg.sheetsWebhookUrl || '');
            let isAdminUnlocked = sessionStorage.getItem('unimus_admin_session') === 'true';
            let isInitialSnapshotLoaded = false;

            // Elemen Utama
            const studentFormCol   = document.getElementById('student-form-column');
            const adminDashCol     = document.getElementById('admin-dashboard-column');
            const btnUnlockAdmin   = document.getElementById('btn-unlock-admin');
            const btnLockAdmin     = document.getElementById('btn-lock-admin');
            const submissionsEl    = document.getElementById('submissions-list');
            const emptyStateEl     = document.getElementById('empty-state');

            // -----------------------------------------------------------------
            // 1. UTILITAS TOAST & CLIPBOARD
            // -----------------------------------------------------------------
            function showToast(title, message, type = 'info') {
                const container = document.getElementById('toast-container');
                const palette = {
                    success: 'bg-emerald-900 text-white border-emerald-700',
                    error:   'bg-rose-900 text-white border-rose-700',
                    warning: 'bg-amber-900 text-white border-amber-700',
                    info:    'bg-unimus-navy text-white border-blue-800'
                };
                const iconMap = {
                    success: 'check-circle-2',
                    error:   'alert-octagon',
                    warning: 'bell-ring',
                    info:    'info'
                };

                const toast = document.createElement('div');
                toast.className = `pointer-events-auto rounded-2xl border p-4 shadow-xl flex items-start gap-3 transition-all duration-300 translate-y-2 opacity-0 ${palette[type] || palette.info}`;
                toast.innerHTML = `
                    <i data-lucide="${iconMap[type] || 'info'}" class="w-5 h-5 shrink-0 mt-0.5"></i>
                    <div class="min-w-0 flex-1">
                        <p class="font-display font-bold text-xs">${title}</p>
                        <p class="text-[11px] opacity-90 mt-0.5 leading-relaxed">${message}</p>
                    </div>
                `;
                container.appendChild(toast);
                lucide.createIcons();

                requestAnimationFrame(() => {
                    toast.classList.remove('translate-y-2', 'opacity-0');
                });

                setTimeout(() => {
                    toast.classList.add('opacity-0', 'translate-y-2');
                    setTimeout(() => toast.remove(), 300);
                }, 4000);
            }

            function copyToClipboard(text, successMsg) {
                const helper = document.getElementById('clipboard-helper');
                helper.value = text;
                helper.select();
                document.execCommand('copy');
                showToast('Tersalin', successMsg, 'success');
            }

            // -----------------------------------------------------------------
            // 2. MANAJEMEN LOGO & BANNER UNIMUS (PATEN UNTUK SEMUA PENGUNJUNG)
            // -----------------------------------------------------------------
            const imgLogo   = document.getElementById('img-unimus-logo');
            const imgBanner = document.getElementById('img-unimus-banner');
            const btnQuickLogo   = document.getElementById('btn-quick-upload-logo');
            const btnQuickBanner = document.getElementById('btn-quick-upload-banner');

            let sharedLogoData   = (typeof savedLogo === 'string' && savedLogo) ? savedLogo : (embeddedCfg.logoData || '');
            let sharedBannerData = (typeof savedBanner === 'string' && savedBanner) ? savedBanner : (embeddedCfg.bannerData || '');

            function applyBrandingAssets() {
                if (sharedLogoData) {
                    imgLogo.src = sharedLogoData;
                    imgLogo.classList.remove('hidden');
                    btnQuickLogo.classList.add('hidden');
                }
                if (sharedBannerData) {
                    imgBanner.src = sharedBannerData;
                    imgBanner.classList.remove('hidden');
                    btnQuickBanner.classList.add('hidden');
                }
            }

            async function saveGlobalSettingsToCloud() {
                await vaultSet(STORAGE_LOGO_DATA, sharedLogoData);
                await vaultSet(STORAGE_BANNER_DATA, sharedBannerData);
                await vaultSet(STORAGE_SHEETS_URL, sheetsWebhookUrl);

                // Simpan juga Logo & Banner ke Google Sheets agar otomatis dimuat semua pengunjung Google Sites
                if (sheetsWebhookUrl) {
                    try {
                        await fetch(sheetsWebhookUrl, {
                            method: 'POST',
                            mode: 'no-cors',
                            headers: { 'Content-Type': 'text/plain;charset=utf-8' },
                            body: JSON.stringify({
                                action: 'save_branding',
                                logoData: sharedLogoData,
                                bannerData: sharedBannerData
                            })
                        });
                    } catch (e) {}
                }

                if (!db || !currentUser) return;
                try {
                    const settingsRef = doc(db, 'artifacts', appId, 'public', 'data', 'portal_settings', 'global_config');
                    await setDoc(settingsRef, {
                        logoData: sharedLogoData,
                        bannerData: sharedBannerData,
                        sheetsWebhookUrl: sheetsWebhookUrl,
                        updatedAt: Date.now()
                    }, { merge: true });
                } catch (err) {
                    console.warn('Gagal menyinkronkan pengaturan global:', err);
                }
            }

            imgLogo.onerror = () => {
                if (sharedLogoData) return;
                imgLogo.classList.add('hidden');
                if (isAdminUnlocked) {
                    btnQuickLogo.classList.remove('hidden');
                    btnQuickLogo.classList.add('inline-flex');
                }
            };

            imgBanner.onerror = () => {
                if (sharedBannerData) return;
                imgBanner.classList.add('hidden');
                if (isAdminUnlocked) {
                    btnQuickBanner.classList.remove('hidden');
                    btnQuickBanner.classList.add('inline-flex');
                }
            };

            function compressAndStoreImage(file, maxWidth, quality, callback) {
                const reader = new FileReader();
                reader.onload = (ev) => {
                    const img = new Image();
                    img.onload = () => {
                        const canvas = document.createElement('canvas');
                        let width = img.width;
                        let height = img.height;
                        if (width > maxWidth) {
                            height = Math.round((height * maxWidth) / width);
                            width = maxWidth;
                        }
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);
                        const outputMime = file.type === 'image/png' ? 'image/png' : 'image/jpeg';
                        const compressedUrl = canvas.toDataURL(outputMime, quality);
                        callback(compressedUrl);
                    };
                    img.src = ev.target.result;
                };
                reader.readAsDataURL(file);
            }

